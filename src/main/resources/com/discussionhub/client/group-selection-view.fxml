<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.GroupSelectionController"
      stylesheets="@app-theme.css"
      spacing="0" style="-fx-background-color: #fcfcfd;">

    <!-- App header bar (kept from existing chrome — not part of the web partial itself) -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #26658C; -fx-padding: 14;">
        <Label text="Discussion Hub"
               style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Select Your Group"
               style="-fx-text-fill: white; -fx-font-size: 14;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="userEmailLabel" text="user@example.com"
               style="-fx-text-fill: white; -fx-font-size: 13;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="0" style="-fx-padding: 32 48 32 48; -fx-background-color: #fcfcfd;">

            <!-- Page title / subtitle -->
            <Label text="Select a Discussion Group"
                   style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #101828;"/>
            <Label text="Browse available groups below and click Join to enroll in the conversation."
                   style="-fx-font-size: 14; -fx-text-fill: #667085;">
                <VBox.margin>
                    <Insets bottom="24" top="6"/>
                </VBox.margin>
            </Label>

            <!-- Search bar -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: white; -fx-border-color: #d0d5dd; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8 8 8 18; -fx-effect: dropshadow(gaussian, rgba(16,24,40,0.08), 4, 0, 0, 1);">
                <Label text="&#128269;" style="-fx-font-size: 14; -fx-text-fill: #667085;"/>
                <TextField fx:id="searchField" promptText="Search for courses, lecturers or topics..."
                           onKeyReleased="#onSearch" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13;"/>
                <Button text="Search  &#8594;" onAction="#onSearch"
                        style="-fx-background-color: #26658C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-padding: 10 28; -fx-background-radius: 8;"/>
            </HBox>

            <!-- Status message -->
            <Label fx:id="statusLabel" visible="false" managed="false"
                   style="-fx-text-fill: #26658C; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="12"/>
                </VBox.margin>
            </Label>

            <!-- Flows left-to-right and wraps naturally, matching Trending Groups
                 (group-browse-view.fxml's groupsFlowPane) instead of a rigid
                 percentWidth 50/50 grid that stretched huge gaps between cards
                 on wide windows. -->
            <FlowPane fx:id="groupCardsContainer" hgap="16" vgap="16">
                <VBox.margin>
                    <Insets top="28" bottom="28"/>
                </VBox.margin>
            </FlowPane>

            <!-- Proceed button, centered, max width like the web's max-width:400px -->
            <HBox alignment="CENTER">
                <Button fx:id="continueButton" text="Proceed to Dashboard  &#8594;" onAction="#onContinue"
                        maxWidth="400" prefWidth="400" prefHeight="46"
                        style="-fx-background-color: #26658C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 8;"/>
            </HBox>

            <!-- Decorative pagination dots -->
            <HBox alignment="CENTER" spacing="8">
                <VBox.margin>
                    <Insets top="28" bottom="12"/>
                </VBox.margin>
                <Region style="-fx-background-color: #26658C; -fx-background-radius: 4; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8;"/>
                <Region style="-fx-background-color: #d0d5dd; -fx-background-radius: 4; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8;"/>
                <Region style="-fx-background-color: #d0d5dd; -fx-background-radius: 4; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8;"/>
                <Region style="-fx-background-color: #d0d5dd; -fx-background-radius: 4; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8;"/>
            </HBox>

            <Label text="You can join additional groups at any time from your dashboard. Some groups may require administrative approval."
                   wrapText="true" alignment="CENTER" style="-fx-font-size: 12; -fx-text-fill: #98a2b3; -fx-font-style: italic;"/>

        </VBox>
    </ScrollPane>

</VBox>
