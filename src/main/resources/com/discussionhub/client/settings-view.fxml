<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Mirrors resources/views/settings/index.blade.php: Profile panel, Password
     panel, Appearance theme swatches, Sessions panel (logout / logout all
     devices), and the right panel (profile mini, security tip). -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.SettingsController"
      styleClass="app-background" stylesheets="@app-theme.css">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 28;">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Back" onAction="#onBack" styleClass="panel-link" style="-fx-background-color: transparent; -fx-padding: 0;"/>
            </HBox>

            <VBox spacing="4">
                <Label text="ACCOUNT" styleClass="muted-text" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                <Label text="Settings" styleClass="heading-text" style="-fx-font-size: 24;"/>
            </VBox>

            <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true"
                   style="-fx-text-fill: #3F9C6B; -fx-font-size: 12.5; -fx-font-weight: bold;"/>
            <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true"
                   style="-fx-text-fill: #D9483D; -fx-font-size: 12.5; -fx-font-weight: bold;"/>

            <HBox spacing="20">
                <!-- MAIN -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity">

                    <VBox styleClass="panel-card">
                        <HBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Profile" styleClass="panel-heading"/>
                        </HBox>
                        <VBox spacing="12" style="-fx-padding: 18 20;">
                            <VBox spacing="4">
                                <Label text="Name" styleClass="muted-text"/>
                                <TextField fx:id="nameField"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Email" styleClass="muted-text"/>
                                <TextField fx:id="emailField"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="panel-card">
                        <HBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Password" styleClass="panel-heading"/>
                        </HBox>
                        <VBox spacing="12" style="-fx-padding: 18 20;">
                            <VBox spacing="4">
                                <Label text="Current password" styleClass="muted-text"/>
                                <PasswordField fx:id="currentPasswordField"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="New password" styleClass="muted-text"/>
                                <PasswordField fx:id="newPasswordField"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Confirm new password" styleClass="muted-text"/>
                                <PasswordField fx:id="confirmPasswordField"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="panel-card">
                        <VBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Appearance" styleClass="panel-heading"/>
                            <Label text="Pick an accent color for the whole site." styleClass="muted-text" style="-fx-padding: 4 0 0 0;"/>
                        </VBox>
                        <HBox fx:id="themeSwatchesBox" spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 18 20;"/>
                    </VBox>

                    <Button text="Save Changes" onAction="#onSave" styleClass="btn-primary" style="-fx-padding: 11 24;"/>

                    <VBox styleClass="panel-card" style="-fx-border-color: #FBE7E5;">
                        <HBox style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Sessions" style="-fx-text-fill: #D9483D; -fx-font-weight: bold; -fx-font-size: 15;"/>
                        </HBox>
                        <HBox spacing="10" style="-fx-padding: 18 20;">
                            <Button text="Logout" onAction="#onLogout"/>
                            <Button text="Log out of all devices" onAction="#onLogoutAllDevices"
                                    style="-fx-text-fill: #D9483D; -fx-border-color: #D9483D;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- RIGHT -->
                <VBox spacing="20" prefWidth="280" minWidth="280">
                    <HBox styleClass="panel-card" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20;">
                        <Label fx:id="userInitialsLabel" text="S"
                               style="-fx-background-color: #26658C; -fx-text-fill: white; -fx-font-weight: bold;
                                      -fx-padding: 10 12; -fx-background-radius: 20; -fx-font-size: 13;"/>
                        <VBox spacing="1">
                            <Label fx:id="userNameLabel" text="Student" styleClass="heading-text" style="-fx-font-size: 13.5;"/>
                            <Label text="Student Account" styleClass="muted-text" style="-fx-font-size: 11.5;"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="announcement-banner" spacing="8" style="-fx-padding: 18 20;">
                        <Label text="🛡 SECURITY" style="-fx-text-fill: white; -fx-font-size: 10.5; -fx-font-weight: bold;"/>
                        <Label text="Keep your profile and password updated to protect your account. Use &quot;Log out of all devices&quot; if you ever sign in on a shared computer."
                               wrapText="true" style="-fx-text-fill: white; -fx-font-size: 12.5;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

</HBox>
