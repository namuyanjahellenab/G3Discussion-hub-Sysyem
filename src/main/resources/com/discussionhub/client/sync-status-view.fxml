<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.SyncStatusController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: #ffffff;" prefWidth="600" prefHeight="400">

    <VBox spacing="5">
        <Label text="Synchronization &amp; Storage Hub" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
        <Label text="Manage local data cache updates and network sync pipelines." style="-fx-text-fill: #666666; -fx-font-size: 13;"/>
    </VBox>

    <Separator/>

    <GridPane hgap="20" vgap="15">
        <VBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="260">
            <Label text="Network Connection State" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle fx:id="statusCircle" radius="6" fill="#cccccc"/>
                <Label fx:id="networkStateLabel" text="Checking network..." style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <VBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="260">
            <Label text="Pending Outbound Sync Items" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
            <Label fx:id="pendingCountLabel" text="0 items pending" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
        </VBox>

        <VBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2" prefWidth="540">
            <Label text="Last Successful Transaction Sync Time" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
            <Label fx:id="lastSyncLabel" text="Never synced" style="-fx-font-size: 14; -fx-font-style: italic;"/>
        </VBox>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Refresh Status Metrics" onAction="#onRefreshMetricsClick"
                style="-fx-background-color: #f1f3f4; -fx-text-fill: #3c4043; -fx-padding: 10 20; -fx-background-radius: 4; -fx-font-weight: bold;"/>
        <Button fx:id="syncNowButton" text="Force Manual Sync Now" onAction="#onSyncNowClick"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 4; -fx-font-weight: bold;"/>
    </HBox>
</VBox>