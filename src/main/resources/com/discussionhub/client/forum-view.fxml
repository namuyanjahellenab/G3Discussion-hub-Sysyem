<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Mirrors resources/views/forum/index.blade.php exactly: stat cards,
     joined-group cards (each opens the group's topic list), Latest Topics,
     profile mini, and the static "join groups" tip banner. -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.ForumController"
      styleClass="app-background" stylesheets="@app-theme.css">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 28;">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Back" onAction="#onBack"
                        style="-fx-background-color: transparent; -fx-border-color: -luna-mid; -fx-text-fill: -luna-mid;
                               -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>
            </HBox>

            <VBox spacing="4">
                <Label text="COMMUNITY" styleClass="muted-text" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                <Label text="Forum" styleClass="heading-text" style="-fx-font-size: 24;"/>
            </VBox>

            <HBox spacing="20">
                <!-- MAIN -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity">

                    <HBox spacing="16">
                        <VBox styleClass="stat-card" style="-fx-padding: 18 20;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="GROUPS JOINED" styleClass="stat-label"/>
                            <Label fx:id="statGroupsLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card" style="-fx-padding: 18 20;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="TOTAL TOPICS" styleClass="stat-label"/>
                            <Label fx:id="statTopicsLabel" text="0" styleClass="stat-value"/>
                        </VBox>
                    </HBox>

                    <FlowPane fx:id="groupsFlowPane" hgap="16" vgap="16"/>

                    <VBox styleClass="panel-card">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Latest Topics" styleClass="panel-heading"/>
                        </HBox>
                        <VBox fx:id="latestTopicsBox"/>
                    </VBox>
                </VBox>

                <!-- RIGHT -->
                <VBox spacing="20" prefWidth="280" minWidth="280">
                    <HBox styleClass="panel-card" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20;">
                        <Label fx:id="userInitialsLabel" text="S"
                               style="-fx-background-color: #26658C; -fx-text-fill: white; -fx-font-weight: bold;
                                      -fx-padding: 10 12; -fx-background-radius: 20; -fx-font-size: 13;"/>
                        <VBox spacing="1">
                            <Label fx:id="userNameLabel" text="Student" styleClass="heading-text" style="-fx-font-size: 13.5;"/>
                            <Label fx:id="userRoleLabel" text="Student Account" styleClass="muted-text" style="-fx-font-size: 11.5;"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="announcement-banner" spacing="8" style="-fx-padding: 18 20;">
                        <Label text="📢 ANNOUNCEMENT" style="-fx-text-fill: white; -fx-font-size: 10.5; -fx-font-weight: bold;"/>
                        <Label text="Join groups to unlock topic discussions and replies." wrapText="true"
                               style="-fx-text-fill: white; -fx-font-size: 12.5;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

    <!-- Hidden — kept only for DashboardController-style window resolution. -->
    <Label fx:id="syncStatusLabel" text="" visible="false" managed="false"/>

</HBox>
