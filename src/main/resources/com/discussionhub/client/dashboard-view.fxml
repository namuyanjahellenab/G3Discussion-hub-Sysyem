<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Mirrors resources/views/dashboard/index.blade.php + layouts/sidebar-student.blade.php:
     same sidebar items, same stat cards, same My Groups / Notifications
     panels, same side panel (profile, upcoming quiz, announcement). The one
     deliberate difference from the web page is the sync status strip and
     Pending Uploads card below - the SDD (figure 6.7, "Desktop offline
     interface") explicitly requires the desktop dashboard to show sync
     status and pending uploads, which has no web equivalent by design. -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.DashboardController"
      styleClass="app-background" stylesheets="@app-theme.css">

    <!-- ================= SIDEBAR ================= -->
    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <!-- ================= CONTENT ================= -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 28;">

            <!-- Page header + sync status strip (desktop-only, SDD figure 6.7) -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="OVERVIEW" styleClass="muted-text" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
                    <Label text="My Dashboard" styleClass="heading-text" style="-fx-font-size: 24;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="syncStatusLabel" text="● OFFLINE" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                    <Label fx:id="lastSyncLabel" text="Last synced: never" styleClass="muted-text"/>
                </VBox>
            </HBox>

            <!-- Stats grid: Groups Joined / Unread Notifications / Participation / Quiz Average -->
            <HBox spacing="16">
                <VBox styleClass="stat-card" style="-fx-padding: 18 20;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="GROUPS JOINED" styleClass="stat-label"/>
                    <Label fx:id="statGroupsLabel" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" style="-fx-padding: 18 20;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="UNREAD NOTIFICATIONS" styleClass="stat-label"/>
                    <Label fx:id="statNotificationsLabel" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox fx:id="participationCard" styleClass="stat-card" style="-fx-padding: 18 20;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="PARTICIPATION" styleClass="stat-label"/>
                    <Label fx:id="statParticipationLabel" text="0 / 10" styleClass="stat-value"/>
                </VBox>
                <VBox fx:id="quizAvgCard" styleClass="stat-card" style="-fx-padding: 18 20;" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="QUIZ AVERAGE" styleClass="stat-label"/>
                    <Label fx:id="statQuizAvgLabel" text="—" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <!-- Two-column panel grid, matching .panels-grid (1.4fr / 1fr) -->
            <HBox spacing="20">

                <!-- LEFT: My Groups + Notifications -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity">

                    <VBox styleClass="panel-card">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="My Groups" styleClass="panel-heading"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="See all" onAction="#onOpenGroupBrowse" styleClass="panel-link" style="-fx-padding: 0;"/>
                        </HBox>
                        <FlowPane fx:id="groupsFlowPane" hgap="16" vgap="16" style="-fx-padding: 20;"/>
                    </VBox>

                    <VBox styleClass="panel-card">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Notifications" styleClass="panel-heading"/>
                        </HBox>
                        <VBox fx:id="recentNotificationsBox"/>
                    </VBox>
                </VBox>

                <!-- RIGHT: profile-mini, Upcoming Quiz, Announcement -->
                <VBox spacing="20" prefWidth="280" minWidth="280">

                    <HBox styleClass="panel-card" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20;">
                        <Label fx:id="userInitialsLabel" text="S"
                               style="-fx-background-color: #26658C; -fx-text-fill: white; -fx-font-weight: bold;
                                      -fx-padding: 10 12; -fx-background-radius: 20; -fx-font-size: 13;"/>
                        <VBox spacing="1">
                            <Label fx:id="userNameLabel" text="Student" styleClass="heading-text" style="-fx-font-size: 13.5;"/>
                            <Label fx:id="userRoleLabel" text="Student Account" styleClass="muted-text" style="-fx-font-size: 11.5;"/>
                        </VBox>
                    </HBox>

                    <!-- Desktop-only: SDD figure 6.7 requires pending-uploads visibility. -->
                    <VBox fx:id="pendingUploadsCard" styleClass="panel-card" spacing="8" alignment="CENTER"
                          style="-fx-padding: 18; -fx-border-style: segments(4,3); -fx-border-color: #B9C8F5; -fx-border-radius: 14;">
                        <Label text="⤴" style="-fx-background-color: #A7EBF2; -fx-text-fill: #023859;
                               -fx-padding: 8 12; -fx-background-radius: 8; -fx-font-size: 14;"/>
                        <Label text="Pending Uploads" styleClass="panel-heading" style="-fx-font-size: 13;"/>
                        <Label fx:id="pendingCountLabel" text="0 items" wrapText="true" textAlignment="CENTER" styleClass="muted-text"/>
                        <Button text="Retry Sync  ⟳" onAction="#onRetrySync" styleClass="btn-primary" maxWidth="Infinity"/>
                    </VBox>

                    <VBox fx:id="upcomingQuizCard" styleClass="panel-card" spacing="6" style="-fx-padding: 20;">
                        <Label text="Upcoming Quiz" styleClass="panel-heading"/>
                        <Label fx:id="upcomingQuizTitleLabel" text="" styleClass="heading-text" style="-fx-font-size: 14;" visible="false" managed="false"/>
                        <Label fx:id="upcomingQuizMetaLabel" text="" styleClass="muted-text" visible="false" managed="false"/>
                        <Button fx:id="upcomingQuizButton" text="View Details" onAction="#onOpenQuizzes"
                                styleClass="btn-primary" visible="false" managed="false">
                            <VBox.margin><Insets top="8"/></VBox.margin>
                        </Button>
                        <Label fx:id="noUpcomingQuizLabel" text="No upcoming quizzes scheduled." styleClass="muted-text"/>
                    </VBox>

                    <VBox fx:id="announcementBanner" styleClass="announcement-banner" spacing="8"
                          style="-fx-padding: 18 20;" visible="false" managed="false">
                        <Label fx:id="announcementTagLabel" text="📢 ANNOUNCEMENT"
                               style="-fx-text-fill: white; -fx-font-size: 10.5; -fx-font-weight: bold;"/>
                        <Label fx:id="announcementBodyLabel" text="" wrapText="true"
                               style="-fx-text-fill: white; -fx-font-size: 12.5;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

</HBox>
