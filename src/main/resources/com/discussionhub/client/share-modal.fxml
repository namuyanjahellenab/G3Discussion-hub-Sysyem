<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.discussionhub.client.ShareModalController"
      spacing="20" style="-fx-background-color: white; -fx-padding: 30;">

    <Label text="Share this post" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <VBox spacing="10" style="-fx-background-color: #f0f0f0; -fx-padding: 15; -fx-background-radius: 6;">
        <Label fx:id="postPreviewLabel" wrapText="true" style="-fx-text-fill: #555; -fx-font-size: 13;"/>
    </VBox>

    <Label text="Share to:" style="-fx-font-weight: bold;"/>

    <HBox spacing="10">
        <ToggleButton fx:id="twitterBtn" text="🐦 Twitter/X" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4; -fx-padding: 8 12;"/>
        <ToggleButton fx:id="facebookBtn" text="📘 Facebook" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4; -fx-padding: 8 12;"/>
        <ToggleButton fx:id="linkedinBtn" text="💼 LinkedIn" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4; -fx-padding: 8 12;"/>
        <Button fx:id="copyLinkBtn" text="🔗 Copy Link" onAction="#onCopyLink" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 4; -fx-padding: 8 12;"/>
    </HBox>

    <VBox spacing="5">
        <Label text="Optional message:" style="-fx-font-size: 12;"/>
        <TextArea fx:id="optionalMessageArea" promptText="Add a personal note... (optional)" prefHeight="80" wrapText="true"
                  style="-fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
    </VBox>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="CANCEL" onAction="#onCancel" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-padding: 10 20;"/>
        <Button text="SHARE NOW" onAction="#onShareNow" style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20;"/>
    </HBox>

</VBox>
