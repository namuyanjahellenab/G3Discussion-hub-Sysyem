<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Mirrors resources/views/quizzes/my-review.blade.php: quiz title + score
     + "submitted X ago" header, then one card per question with a colored
     top border (green=correct, red=incorrect), "Your answer" and - only if
     wrong or unanswered - "Correct answer". Had zero desktop equivalent
     before (no API route, no Java UI) - students could never see which
     answers were right/wrong. -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.QuizReviewController"
      styleClass="app-background" stylesheets="@app-theme.css">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 28;" maxWidth="800">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="← Back to Quizzes" onAction="#onBack"
                        style="-fx-background-color: transparent; -fx-border-color: -luna-mid; -fx-text-fill: -luna-mid;
                               -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>
            </HBox>

            <VBox spacing="4">
                <Label fx:id="titleLabel" text="Quiz — Your Review" styleClass="heading-text" style="-fx-font-size: 22;"/>
                <Label fx:id="metaLabel" text="" styleClass="muted-text" style="-fx-font-size: 13;"/>
            </VBox>

            <VBox fx:id="questionsBox" spacing="14"/>

        </VBox>
    </ScrollPane>

    <Label fx:id="syncStatusLabel" text="" visible="false" managed="false"/>

</HBox>
