<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Mirrors resources/views/forum/group.blade.php exactly: breadcrumb, New
     Topic button, search, filter chips with live counts, topic rows with
     status/pinned/restricted/flagged badges, pagination, and the right
     panel (profile, Group Info, tip banner). -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.GroupTopicsController"
      styleClass="app-background" stylesheets="@app-theme.css">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 28;">

            <Label fx:id="breadcrumbLabel" text="Home › Group › Forum" styleClass="muted-text"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="groupTitleLabel" text="Group" styleClass="heading-text" style="-fx-font-size: 24;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ New Topic" onAction="#onNewTopic" styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="20">
                <!-- MAIN -->
                <VBox spacing="14" HBox.hgrow="ALWAYS" maxWidth="Infinity">

                    <TextField fx:id="searchField" promptText="Search topics..." onAction="#onSearch"/>

                    <HBox fx:id="filterRow" spacing="8"/>

                    <VBox fx:id="topicsBox" styleClass="panel-card"/>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="paginationLabel" text="" styleClass="muted-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="← Prev" fx:id="prevButton" onAction="#onPrevPage"/>
                        <Button text="Next →" fx:id="nextButton" onAction="#onNextPage"/>
                    </HBox>
                </VBox>

                <!-- RIGHT -->
                <VBox spacing="20" prefWidth="280" minWidth="280">
                    <HBox styleClass="panel-card" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20;">
                        <Label fx:id="userInitialsLabel" text="S"
                               style="-fx-background-color: #26658C; -fx-text-fill: white; -fx-font-weight: bold;
                                      -fx-padding: 10 12; -fx-background-radius: 20; -fx-font-size: 13;"/>
                        <VBox spacing="1">
                            <Label fx:id="userNameLabel" text="Student" styleClass="heading-text" style="-fx-font-size: 13.5;"/>
                            <Label text="Student Account" styleClass="muted-text" style="-fx-font-size: 11.5;"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="panel-card">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 20; -fx-border-color: transparent transparent #E1E9ED transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="Group Info" styleClass="panel-heading"/>
                        </HBox>
                        <VBox spacing="8" style="-fx-padding: 16 20;">
                            <HBox>
                                <Label text="Topics" styleClass="muted-text"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="groupTopicCountLabel" text="0" styleClass="heading-text"/>
                            </HBox>
                            <Hyperlink text="← Back to all groups" onAction="#onBackToForum" styleClass="panel-link" style="-fx-padding: 0;"/>
                        </VBox>
                    </VBox>

                    <VBox styleClass="announcement-banner" spacing="8" style="-fx-padding: 18 20;">
                        <Label text="📢 TIP" style="-fx-text-fill: white; -fx-font-size: 10.5; -fx-font-weight: bold;"/>
                        <Label text="Pin important topics and mark answers as accepted to keep this forum easy to navigate."
                               wrapText="true" style="-fx-text-fill: white; -fx-font-size: 12.5;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

    <Label fx:id="syncStatusLabel" text="" visible="false" managed="false"/>

</HBox>
