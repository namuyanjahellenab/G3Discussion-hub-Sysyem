<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.QuizModalController"
      spacing="16" prefWidth="620" prefHeight="520"
      style="-fx-background-color: white; -fx-padding: 24; -fx-border-color: #ddd; -fx-border-width: 1;">

    <!-- Top section -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="quizTitleLabel" text="Quiz Title"
               style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1a73e8;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="timerLabel" text="00:00"
               style="-fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #d32f2f;"/>
    </HBox>

    <Separator/>

    <!-- Question counter -->
    <Label fx:id="questionCountLabel" text="Question 1 of X"
           style="-fx-text-fill: grey; -fx-font-size: 12;"/>

    <!-- Question text -->
    <Label fx:id="questionTextLabel" text="Question text goes here..."
           wrapText="true" maxWidth="Infinity"
           style="-fx-font-weight: bold; -fx-font-size: 15; -fx-padding: 12; -fx-background-color: #f5f5f5; -fx-background-radius: 6;"/>

    <!-- Answers area -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox fx:id="answersContainer" spacing="10">
            <!-- Radio buttons added dynamically -->
        </VBox>
    </ScrollPane>

    <!-- Navigation row -->
    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="prevButton" text="← Previous" onAction="#onPrevious"
                style="-fx-background-color: white; -fx-border-color: #1a73e8; -fx-text-fill: #1a73e8; -fx-background-radius: 6; -fx-padding: 8 16;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="nextButton" text="Next →" onAction="#onNext"
                style="-fx-background-color: white; -fx-border-color: #1a73e8; -fx-text-fill: #1a73e8; -fx-background-radius: 6; -fx-padding: 8 16;"/>
    </HBox>

    <!-- Submit button -->
    <Button text="SUBMIT QUIZ" onAction="#onSubmitQuiz" maxWidth="Infinity"
            style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 6;"/>

    <!-- Warning label -->
    <Label text="⚠ This quiz will auto-submit when the timer expires."
           alignment="CENTER" maxWidth="Infinity"
           style="-fx-text-fill: grey; -fx-font-size: 11; -fx-font-style: italic;"/>

</VBox>
