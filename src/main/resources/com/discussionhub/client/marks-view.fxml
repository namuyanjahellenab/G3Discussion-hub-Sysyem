<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Mirrors resources/views/marks/index.blade.php: one panel per group
     (Participation + Quiz Performance stat cards, then that group's quiz
     rows) plus the right profile/tip panel - previously this screen was
     just SimpleListController.loadMarks(), three flat stat tiles in a row
     with no right panel at all. -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.MarksController"
      styleClass="app-background" stylesheets="@app-theme.css">

    <fx:include fx:id="sidebar" source="sidebar.fxml"/>

    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="16" style="-fx-padding: 28;">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Back" onAction="#onBack"
                        style="-fx-background-color: transparent; -fx-border-color: -luna-mid; -fx-text-fill: -luna-mid;
                               -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand;"/>
            </HBox>

            <VBox>
                <Label text="Performance" styleClass="muted-text" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label text="Marks" styleClass="heading-text" style="-fx-font-size: 22;"/>
            </VBox>

            <HBox spacing="20">
                <!-- MAIN -->
                <VBox fx:id="groupsBox" spacing="16" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>

                <!-- RIGHT -->
                <VBox spacing="20" prefWidth="280" minWidth="280">
                    <HBox styleClass="panel-card" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 20;">
                        <Label fx:id="userInitialsLabel" text="S"
                               style="-fx-background-color: -luna-mid; -fx-text-fill: white; -fx-font-weight: bold;
                                      -fx-padding: 10 12; -fx-background-radius: 20; -fx-font-size: 13;"/>
                        <VBox spacing="1">
                            <Label fx:id="userNameLabel" text="Student" styleClass="heading-text" style="-fx-font-size: 13.5;"/>
                            <Label fx:id="userRoleLabel" text="Student Account" styleClass="muted-text" style="-fx-font-size: 11.5;"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="announcement-banner" spacing="8" style="-fx-padding: 18 20;">
                        <Label text="📢 HOW MARKS WORK" style="-fx-text-fill: white; -fx-font-size: 10.5; -fx-font-weight: bold;"/>
                        <Label text="Participation is scored per group, relative to the platform's most active participant. Quiz marks are shown per group as attempted."
                               wrapText="true" style="-fx-text-fill: white; -fx-font-size: 12.5;"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>

    <Label fx:id="syncStatusLabel" text="" visible="false" managed="false"/>

</HBox>
