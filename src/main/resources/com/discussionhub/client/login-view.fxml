<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<!-- Mirrors resources/views/auth/login.blade.php + components/auth-layout.blade.php
     exactly - the auth pages use their own distinct blue (#0052CC), separate
     from the LUNA theme used on every other screen. -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.discussionhub.client.LoginController"
      alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to bottom right, #E8F1FF, #D4E3FF); -fx-padding: 40;">

    <VBox alignment="CENTER" spacing="15" maxWidth="400"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);">

        <Label text="Discussion Hub" style="-fx-text-fill: #0052CC; -fx-font-size: 28; -fx-font-weight: bold;"/>
        <Label text="Welcome back! Please login to your account." style="-fx-text-fill: #6B7280; -fx-font-size: 14;"/>

        <VBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Email Address:" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 13;"/>
            <TextField fx:id="emailField" promptText="user@example.com"
                       style="-fx-padding: 10; -fx-background-color: #F0F7FF; -fx-border-color: #E5E7EB; -fx-border-radius: 5; -fx-background-radius: 5;"/>

            <Label text="Password:" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 13;"/>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="••••••••"
                                   style="-fx-padding: 10; -fx-background-color: #F0F7FF; -fx-border-color: #E5E7EB; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                    <TextField fx:id="passwordVisible" promptText="••••••••" visible="false"
                               style="-fx-padding: 10; -fx-background-color: #F0F7FF; -fx-border-color: #E5E7EB; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                </StackPane>
                <Button fx:id="showPasswordBtn" text="👁" onAction="#onTogglePassword"
                        style="-fx-background-color: transparent; -fx-text-fill: #0052CC; -fx-padding: 8;"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="rememberMeCheck" text="Remember me" style="-fx-text-fill: #4B5563; -fx-font-size: 13;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Forgot Password?" onAction="#onForgotPassword" style="-fx-text-fill: #0052CC; -fx-font-size: 13; -fx-padding: 0;"/>
        </HBox>

        <Button text="LOGIN" onAction="#onLogin" maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to bottom right, #0052CC, #1473E6); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-padding: 13; -fx-background-radius: 5;"/>

        <Label fx:id="errorLabel" text="Invalid credentials." style="-fx-text-fill: #EF4444; -fx-font-size: 13;" visible="false"/>
        <Label fx:id="statusLabel" visible="false"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
            <Hyperlink text="Register here" onAction="#onRegister" style="-fx-text-fill: #0052CC; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 0;"/>
        </HBox>
    </VBox>

</VBox>
