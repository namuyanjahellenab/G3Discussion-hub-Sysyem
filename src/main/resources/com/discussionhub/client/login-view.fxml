<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.discussionhub.client.LoginController"
      alignment="CENTER" spacing="20" style="-fx-background-color: #e8eef7; -fx-padding: 40;">

    <VBox alignment="CENTER" spacing="15" maxWidth="400"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <Label text="Discussion Hub" style="-fx-text-fill: #1a73e8; -fx-font-size: 28; -fx-font-weight: bold;"/>
        <Label text="Welcome back! Please login to your account." style="-fx-text-fill: grey; -fx-font-size: 14;"/>

        <VBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Email Address" style="-fx-font-weight: bold;"/>
            <TextField fx:id="emailField" promptText="email@example.com"
                       style="-fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>

            <Label text="Password" style="-fx-font-weight: bold;"/>
            <HBox spacing="5" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="Enter password"
                                   style="-fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    <TextField fx:id="passwordVisible" promptText="Enter password" visible="false"
                               style="-fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                </StackPane>
                <Button fx:id="showPasswordBtn" text="👁" onAction="#onTogglePassword"
                        style="-fx-background-color: transparent; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-padding: 8;"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="rememberMeCheck" text="Remember me"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Forgot Password?" onAction="#onForgotPassword" style="-fx-text-fill: #1a73e8;"/>
        </HBox>

        <Button text="LOGIN" onAction="#onLogin" maxWidth="Infinity"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 6;"/>

        <Label fx:id="errorLabel" text="Invalid credentials." style="-fx-text-fill: red;" visible="false"/>
        <Label fx:id="statusLabel" visible="false"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?"/>
            <Hyperlink text="Register here" onAction="#onRegister" style="-fx-text-fill: #1a73e8;"/>
        </HBox>
    </VBox>

</VBox>
