<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discussionhub.client.TopicController"
      spacing="12" style="-fx-background-color: #f4f6f9; -fx-padding: 20;">

    <!-- Header bar -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1a73e8; -fx-padding: 14; -fx-background-radius: 8;">
        <Button text="← Back" onAction="#onBack"
                style="-fx-background-color: transparent; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 4 10;"/>
        <Label fx:id="topicTitleLabel" text="Topic Title"
               style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"
               wrapText="true" HBox.hgrow="ALWAYS"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Export to PDF button — per SDD figure 6.8 -->
        <Button text="⬇ Export PDF" onAction="#onExportPdf"
                style="-fx-background-color: white; -fx-text-fill: #1a73e8;
                       -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 6;"/>
        <Label fx:id="syncStatusLabel" text="● OFFLINE"
               style="-fx-text-fill: #ffcc00; -fx-font-size: 12; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Offline banner -->
    <HBox fx:id="offlineBanner" alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: #fff4ce; -fx-padding: 10; -fx-background-radius: 6;"
          visible="false" managed="false">
        <Label text="⚠  Offline — your reply will be queued and uploaded when you reconnect."
               style="-fx-text-fill: #7a5c00; -fx-font-size: 12;"/>
    </HBox>

    <!-- Thread scroll area: original post + indented replies -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox fx:id="threadContainer" spacing="10"
              style="-fx-padding: 4;">

            <!-- Original post card — populated programmatically by TopicController -->
            <VBox fx:id="originalPostCard" spacing="6"
                  style="-fx-background-color: white; -fx-padding: 16;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(gaussian, #cccccc, 4, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="originalAuthorLabel" text="Author"
                           style="-fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
                    <Label fx:id="originalTimeLabel" text=""
                           style="-fx-text-fill: #888; -fx-font-size: 11;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Filter and Share per SDD figure 6.8 -->
                    <Button text="Filter" onAction="#onFilterPost"
                            style="-fx-padding: 4 10; -fx-background-radius: 4;"/>
                    <Button text="Share" onAction="#onSharePost"
                            style="-fx-padding: 4 10; -fx-background-radius: 4;"/>
                </HBox>
                <Label fx:id="originalContentLabel" text=""
                       wrapText="true" style="-fx-font-size: 13;"/>
            </VBox>

            <!-- Replies are added dynamically by TopicController.loadReplies()
                 Each reply is a VBox with left-margin indent (16px) to show threading.
                 Accepted answers get a green border per SDD figure 6.8.
                 TopicController.buildReplyCard(content, author, time, isAccepted)
                 builds each card and adds it to threadContainer. -->

        </VBox>
    </ScrollPane>

    <!-- Reply box at the bottom — per SDD figure 6.8 -->
    <VBox spacing="8"
          style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8;
                 -fx-effect: dropshadow(gaussian, #cccccc, 4, 0, 0, 2);">
        <Label text="Write a reply" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextArea fx:id="replyInput" promptText="Type your reply here..."
                  prefRowCount="3" wrapText="true"
                  style="-fx-border-color: #ddd; -fx-border-radius: 6;"/>
        <HBox alignment="CENTER_RIGHT">
            <Button text="Post Reply" onAction="#onPostReply"
                    style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 8 22; -fx-background-radius: 6;"/>
        </HBox>
    </VBox>

</VBox>
